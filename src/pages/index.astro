---
import { hygraph } from "../lib/hygraph";
import type { Item } from "../lib/types";

export const prerender = false;

const { items } = await hygraph<{ items: Item[] }>(`
  query {
    items {
      id
      title
      status_Item
      category
      pessoas { id name }
    }
  }
`);
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Nossos sonhos</title>
  </head>
  <body>
    <h1>Nossos sonhos</h1>
    <ul>
      {items.map((item) => (
        <li>
          <strong>{item.title}</strong>
          — {item.category} · {item.status_Item}
          <br />
          <small>
            {item.pessoas.length > 1 ? "Do casal" : item.pessoas[0]?.name}
          </small>
        </li>
      ))}
    </ul>
  </body>
</html>