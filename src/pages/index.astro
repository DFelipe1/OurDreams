---
import { hygraph } from "../lib/hygraph";
import type { Item } from "../lib/types";

export const prerender = false;

const { items } = await hygraph<{ items: Item[] }>(`
  query {
    items {
      id
      title
      status_Item
      category
      pessoas { id name }
    }
  }
`);

let recente: Item | null = null;
try {
  recente = Astro.cookies.get("recente")?.json() ?? null;
} catch {
  recente = null;
}

const novo = recente;
if (novo && !items.some((i) => i.id === novo.id)) {
  items.push(novo);
}

if (novo) {
  const posicao = items.findIndex((i) => i.id === novo.id);
  if (posicao === -1) items.unshift(novo);
  else items[posicao] = novo;
}

---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Nossos sonhos</title>
  </head>
  <body>
    <h1>Nossos sonhos</h1>
    <a href="/novo">+ Novo item</a>
    <ul>
      {items.map((item) => (
        <li>
          <strong>{item.title}</strong>
          — {item.category} · {item.status_Item}
          <br />
          <small>
            {item.pessoas.length > 1 ? "Do casal" : item.pessoas[0]?.name}
          </small>
          {item.status_Item !== "realizado" && (
            <form method="POST" action="/api/concluir">
              <input type="hidden" name="id" value={item.id} />
              <button type="submit">Marcar como realizado</button>
            </form>
          )}
        </li>
      ))}
    </ul>
  </body>
</html>